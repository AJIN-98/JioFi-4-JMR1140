#!/bin/sh
# CGI save script for OpenFi Repeater Web UI

. /usr/lib/repeater_auth.sh
auth_require_wifi
REQUEST_ROLE=$(auth_role)

json_error() {
    echo "Content-type: application/json"
    echo ""
    printf '{"success":false,"error":"%s"}\n' "$1"
    exit 0
}

is_ipv4() {
    printf '%s\n' "$1" | awk -F. '
        NF != 4 { bad = 1 }
        {
            for (i = 1; i <= 4; i++) {
                if ($i !~ /^[0-9]+$/ || length($i) > 3 || $i > 255) {
                    bad = 1
                }
            }
        }
        END { exit bad }
    '
}

get_configured_ssid() {
    CONFIG="$1"
    [ -f "$CONFIG" ] || return 0
    sed -n 's/^[[:space:]]*ssid="\([^"]*\)".*/\1/p' "$CONFIG" | head -n 1
}

valid_text() {
    case "$1" in
        *'"'*|*'\'*|*'
'*) return 1 ;;
    esac
    printf '%s' "$1" | LC_ALL=C grep -q '^[ -~]*$'
}

case "$CONTENT_LENGTH" in
    ""|*[!0-9]*) json_error "Invalid request size" ;;
esac
case "$CONTENT_LENGTH" in
    ?????*) json_error "Invalid request size" ;;
esac
if [ "$CONTENT_LENGTH" -eq 0 ] || [ "$CONTENT_LENGTH" -gt 4096 ]; then
    json_error "Invalid request size"
fi
if [ "$REQUEST_METHOD" != "POST" ] || [ "$CONTENT_TYPE" != "application/json" ]; then
    json_error "POST with application/json is required"
fi

DATA=$(head -c "$CONTENT_LENGTH")
SSID=$(printf '%s' "$DATA" | grep -o '"ssid":"[^"]*' | cut -d'"' -f4)
PASS=$(printf '%s' "$DATA" | grep -o '"password":"[^"]*' | cut -d'"' -f4)
AP_SSID=$(printf '%s' "$DATA" | grep -o '"ap_ssid":"[^"]*' | cut -d'"' -f4)
AP_PASS=$(printf '%s' "$DATA" | grep -o '"ap_pass":"[^"]*' | cut -d'"' -f4)
IP_MODE=$(printf '%s' "$DATA" | grep -o '"ip_mode":"[^"]*' | cut -d'"' -f4)
IP_ADDR=$(printf '%s' "$DATA" | grep -o '"ip_addr":"[^"]*' | cut -d'"' -f4)
NETMASK=$(printf '%s' "$DATA" | grep -o '"netmask":"[^"]*' | cut -d'"' -f4)
GATEWAY=$(printf '%s' "$DATA" | grep -o '"gateway":"[^"]*' | cut -d'"' -f4)
OPEN_NETWORK=$(printf '%s' "$DATA" | grep -o '"open_network":"[^"]*' | cut -d'"' -f4)
REQUEST_DNS_SERVER=$(printf '%s' "$DATA" | grep -o '"dns_server":"[^"]*' | cut -d'"' -f4)
REQUEST_POWER_LED=$(printf '%s' "$DATA" | grep -o '"power_led":"[^"]*' | cut -d'"' -f4)
REQUEST_WIFI_LED=$(printf '%s' "$DATA" | grep -o '"wifi_led":"[^"]*' | cut -d'"' -f4)
REQUEST_RSSI_LED=$(printf '%s' "$DATA" | grep -o '"rssi_led":"[^"]*' | cut -d'"' -f4)
REQUEST_POWER_SAVE=$(printf '%s' "$DATA" | grep -o '"power_save":"[^"]*' | cut -d'"' -f4)

if [ "$REQUEST_ROLE" = "user" ]; then
    if [ -z "$AP_PASS" ] ||
       printf '%s' "$DATA" | grep -Eq '"(ssid|password|ap_ssid|ip_mode|ip_addr|netmask|gateway|open_network|dns_server|power_led|wifi_led|rssi_led|power_save)"[[:space:]]*:'; then
        json_error "User accounts can only change the hotspot Wi-Fi password"
    fi
fi

case "$OPEN_NETWORK" in
    ""|true|false) ;;
    *) json_error "Invalid upstream network security setting" ;;
esac

if [ -n "$SSID" ]; then
    SSID_LEN=$(printf '%s' "$SSID" | wc -c | tr -d ' ')
    if [ "$SSID_LEN" -gt 32 ] || ! valid_text "$SSID"; then
        json_error "SSID must be 1-32 printable characters without quotes or backslashes"
    fi
fi
if [ -n "$PASS" ]; then
    PASS_LEN=$(printf '%s' "$PASS" | wc -c | tr -d ' ')
    if [ "$PASS_LEN" -lt 8 ] || [ "$PASS_LEN" -gt 63 ] || ! valid_text "$PASS"; then
        json_error "Wi-Fi password must be 8-63 printable characters without quotes or backslashes"
    fi
fi
if [ -n "$AP_SSID" ]; then
    AP_SSID_LEN=$(printf '%s' "$AP_SSID" | wc -c | tr -d ' ')
    if [ "$AP_SSID_LEN" -gt 32 ] || ! valid_text "$AP_SSID"; then
        json_error "Hotspot SSID must be 1-32 printable characters without quotes or backslashes"
    fi
fi
if [ -n "$AP_PASS" ]; then
    AP_PASS_LEN=$(printf '%s' "$AP_PASS" | wc -c | tr -d ' ')
    if [ "$AP_PASS_LEN" -lt 8 ] || [ "$AP_PASS_LEN" -gt 63 ] || ! valid_text "$AP_PASS"; then
        json_error "Hotspot password must be 8-63 printable characters without quotes or backslashes"
    fi
fi
if [ -n "$SSID" ] && [ -z "$PASS" ] && [ "$OPEN_NETWORK" != "true" ]; then
    CURRENT_WPA_CONF="/data/wpa_supplicant.conf"
    [ -f "$CURRENT_WPA_CONF" ] || CURRENT_WPA_CONF="/etc/wpa_supplicant.conf"
    CURRENT_SSID=$(get_configured_ssid "$CURRENT_WPA_CONF")
    if [ "$SSID" != "$CURRENT_SSID" ]; then
        json_error "Enter the upstream password, or select the open-network option"
    fi
    SSID=""
    APPLY_UPSTREAM=1
fi
if [ -n "$AP_SSID" ] || [ -n "$AP_PASS" ]; then
    CURRENT_AP_CONF="/data/hostapd.conf"
    [ -f "$CURRENT_AP_CONF" ] || CURRENT_AP_CONF="/etc/hostapd.conf"
    CURRENT_AP_SSID=$(grep '^ssid=' "$CURRENT_AP_CONF" 2>/dev/null | cut -d= -f2)
    if [ -z "$AP_SSID" ] && [ -n "$AP_PASS" ]; then
        AP_SSID="$CURRENT_AP_SSID"
    elif [ -n "$AP_SSID" ] && [ -z "$AP_PASS" ] && [ "$AP_SSID" != "$CURRENT_AP_SSID" ]; then
        json_error "Enter a new hotspot password when changing the hotspot name"
    elif [ -n "$AP_SSID" ] && [ -z "$AP_PASS" ]; then
        AP_SSID=""
    fi
fi

OPTIONS_REQUESTED=0
if printf '%s' "$DATA" | grep -Eq '"(dns_server|power_led|wifi_led|rssi_led|power_save)"[[:space:]]*:'; then
    [ "$REQUEST_ROLE" = "admin" ] || json_error "Only administrators can change repeater options"
    . /usr/lib/repeater_options.sh
    repeater_load_options
    if printf '%s' "$DATA" | grep -q '"dns_server"[[:space:]]*:'; then DNS_SERVER="$REQUEST_DNS_SERVER"; fi
    if printf '%s' "$DATA" | grep -q '"power_led"[[:space:]]*:'; then POWER_LED="$REQUEST_POWER_LED"; fi
    if printf '%s' "$DATA" | grep -q '"wifi_led"[[:space:]]*:'; then WIFI_LED="$REQUEST_WIFI_LED"; fi
    if printf '%s' "$DATA" | grep -q '"rssi_led"[[:space:]]*:'; then RSSI_LED="$REQUEST_RSSI_LED"; fi
    if printf '%s' "$DATA" | grep -q '"power_save"[[:space:]]*:'; then POWER_SAVE="$REQUEST_POWER_SAVE"; fi
    repeater_valid_ipv4 "$DNS_SERVER" || json_error "Enter a valid IPv4 DNS server"
    case "$POWER_LED:$WIFI_LED:$RSSI_LED:$POWER_SAVE" in
        [01]:[01]:[01]:[01]) ;;
        *) json_error "Invalid LED or power-saving setting" ;;
    esac
    OPTIONS_REQUESTED=1
fi

if [ -n "$IP_MODE" ]; then
    [ "$REQUEST_ROLE" = "admin" ] || json_error "Only administrators can change IP settings"
    case "$IP_MODE" in
        dhcp) ;;
        static)
            if ! is_ipv4 "$IP_ADDR" || ! is_ipv4 "$NETMASK" || ! is_ipv4 "$GATEWAY"; then
                json_error "A valid static IP, subnet mask, and gateway are required"
            fi
            ;;
        *) json_error "Invalid IP assignment mode" ;;
    esac
fi

if [ -n "$IP_MODE" ]; then
    TMP="/data/ip_config.conf.$$"
    {
        printf 'IP_MODE="%s"\n' "$IP_MODE"
        printf 'IP_ADDR="%s"\n' "$IP_ADDR"
        printf 'NETMASK="%s"\n' "$NETMASK"
        printf 'GATEWAY="%s"\n' "$GATEWAY"
    } > "$TMP" && mv "$TMP" /data/ip_config.conf || json_error "Unable to save IP configuration"
    APPLY_IP=1
fi

if [ "$OPTIONS_REQUESTED" = "1" ]; then
    OPTIONS_TMP="/data/repeater-options.conf.$$"
    {
        printf 'dns_server=%s\n' "$DNS_SERVER"
        printf 'power_led=%s\n' "$POWER_LED"
        printf 'wifi_led=%s\n' "$WIFI_LED"
        printf 'rssi_led=%s\n' "$RSSI_LED"
        printf 'power_save=%s\n' "$POWER_SAVE"
    } > "$OPTIONS_TMP" && chmod 600 "$OPTIONS_TMP" && mv "$OPTIONS_TMP" /data/repeater-options.conf ||
        json_error "Unable to save repeater options"
fi

if [ -n "$SSID" ]; then
    TMP="/data/wpa_supplicant.conf.$$"
    {
        printf 'ctrl_interface=/var/run/wpa_supplicant\n'
        printf 'update_config=1\n\n'
        printf 'network={\n\tssid="%s"\n' "$SSID"
        if [ -n "$PASS" ]; then
            printf '\tpsk="%s"\n' "$PASS"
            printf '\tkey_mgmt=WPA-PSK\n'
        else
            printf '\tkey_mgmt=NONE\n'
        fi
        printf '}\n'
    } > "$TMP" && mv "$TMP" /data/wpa_supplicant.conf || json_error "Unable to save upstream Wi-Fi configuration"
    APPLY_UPSTREAM=1
fi

if [ -n "$AP_SSID" ] && [ -n "$AP_PASS" ]; then
    TMP="/data/hostapd.conf.$$"
    {
        printf 'interface=wlan1\n'
        printf 'driver=nl80211\n'
        printf 'ctrl_interface=/var/run/hostapd\n'
        printf 'ssid=%s\n' "$AP_SSID"
        printf 'hw_mode=g\nchannel=1\nwpa=2\n'
        printf 'wpa_passphrase=%s\n' "$AP_PASS"
        printf 'wpa_key_mgmt=WPA-PSK\nwpa_pairwise=CCMP\nrsn_pairwise=CCMP\n'
        printf 'eap_server=1\nwps_state=2\nap_setup_locked=0\n'
        printf 'device_name=OpenFi Repeater\nmanufacturer=Jio\nmodel_name=JMR1140\n'
        printf 'model_number=1\nserial_number=JMR1140\nconfig_methods=push_button\n'
        printf 'uuid=8d7f0d7b-8b5a-4f2e-9f4f-4d4a494f4649\n'
    } > "$TMP" && mv "$TMP" /data/hostapd.conf || json_error "Unable to save hotspot configuration"
    APPLY_HOTSPOT=1
fi

if [ -n "$SSID" ] || [ -n "$AP_SSID" ] || [ -n "$IP_MODE" ] ||
   [ "$OPTIONS_REQUESTED" = "1" ] ||
   { [ -n "$AP_PASS" ] && [ "$REQUEST_ROLE" = "user" ]; }; then
    printf 'restart_pending\n' > /data/repeater_apply.status.$$ &&
        mv /data/repeater_apply.status.$$ /data/repeater_apply.status ||
        json_error "Settings were saved, but restart status could not be recorded"
    if mkdir /data/repeater-reboot.lock 2>/dev/null; then
        (
            /bin/busybox sleep 30
            echo restarting > /data/repeater_apply.status
            /sbin/reboot
            echo failed > /data/repeater_apply.status
            rmdir /data/repeater-reboot.lock 2>/dev/null
        ) >/dev/null 2>&1 </dev/null &
    fi
fi

echo "Content-type: application/json"
echo ""
echo '{"success":true}'
